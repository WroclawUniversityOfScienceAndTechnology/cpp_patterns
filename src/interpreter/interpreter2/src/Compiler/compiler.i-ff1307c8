    {
        template <typename T, typename Policies>
        void clear_queue(multi_pass<T, Policies>& mp
          , traits::clear_mode::enum_type mode)
        {
            mp.clear_queue(mode);
        }

        template <typename T, typename Policies>
        void inhibit_clear_queue(multi_pass<T, Policies>& mp, bool flag)
