                           const std::vector<std::string>& new_tokens,
                           bool utf8) const
            = 0;




        virtual bool apply_default(boost::any& value_store) const = 0;



        virtual void notify(const boost::any& value_store) const = 0;

        virtual ~value_semantic() {}
