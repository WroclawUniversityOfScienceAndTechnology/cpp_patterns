    {
        template <typename Sequence, typename F>
        struct for_each;
    }

    template <typename Sequence, typename F>

    inline typename
        enable_if<
            traits::is_sequence<Sequence>
          , void
        >::type
    for_each(Sequence& seq, F const& f);

    template <typename Sequence, typename F>

    inline typename
