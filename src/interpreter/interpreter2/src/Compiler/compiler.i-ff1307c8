namespace boost { namespace spirit { namespace ucd
{



    struct properties
    {




        enum major_category
        {
            letter,
            mark,
            number,
            separator,
            other,
            punctuation,
            symbol
        };

        enum category
        {
            uppercase_letter = 0,
            lowercase_letter,
            titlecase_letter,
            modifier_letter,
            other_letter,

            nonspacing_mark = 8,
            enclosing_mark,
            spacing_mark,

            decimal_number = 16,
            letter_number,
            other_number,

            space_separator = 24,
