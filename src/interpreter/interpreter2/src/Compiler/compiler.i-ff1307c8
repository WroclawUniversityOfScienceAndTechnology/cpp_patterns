    template<typename T>
    static std::streampos seek( T& t, stream_offset off,
                                std::ios::seekdir way,
                                std::ios::openmode which )
    {
        if ( way == std::ios::beg &&
             ( off < integer_traits<std::streamoff>::const_min ||
               off > integer_traits<std::streamoff>::const_max ) )
        {
