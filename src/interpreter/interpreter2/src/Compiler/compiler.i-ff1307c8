    void swap(buffer& rhs);


    template<typename Source>
    typename int_type_of<Source>::type fill(Source& src)
    {
        using namespace std;
        std::streamsize keep;
        if ((keep = static_cast<std::streamsize>(eptr_ - ptr_)) > 0)
            traits_type::move(
                this->data(),
                ptr_,
                static_cast<size_t>(keep)
            );
        set(0, keep);
