        lhs_.indicate_which(rhs_which_);
    }

    template <typename LhsT>
    void backup_assign_impl(
          LhsT& lhs_content
        , mpl::false_
        , int
        )
    {

        LhsT* backup_lhs_ptr = new LhsT(lhs_content);


